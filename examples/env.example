# Open Archiver Thunderbird Extension - Environment Configuration
# Copy this file to .env and fill in your values.

# Open Archiver API base URL (backend server, default port 4000)
OA_API_BASE_URL=http://localhost:4000

# Open Archiver Web UI base URL (frontend, default port 3000)
OA_FRONTEND_BASE_URL=http://localhost:3000

# API Key or JWT Bearer Token
# Generate an API key in Open Archiver Settings → API Keys
# The key must have the `search:archive` permission.
OA_API_KEY=oa_live_your_key_here

# Default search options
OA_DEFAULT_RESULT_LIMIT=20
OA_DEFAULT_DATE_RANGE_DAYS=365
